# wdk on PATH (dev shell, direnv) or, from a plain terminal, via the dev shell per call.
wdk := if `command -v wdk || true` != "" { "wdk" } else { "nix develop -c wdk" }

default:
    @just --list

# required by wdk: a foreground server on PORT
serve-at PORT:
    {{wdk}} serve-dir site {{PORT}}

# no build step
build:

# compat + smoke + a11y on one server
check:
    {{wdk}} check
