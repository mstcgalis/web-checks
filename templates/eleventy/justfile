# wdk lives in the nix dev shell; from a plain terminal, enter it per call.
wdk := if env("IN_NIX_SHELL", "") != "" { "wdk" } else { "nix develop -c wdk" }

default:
    @just --list

serve-at PORT:
    {{wdk}} serve-dir _site {{PORT}}

build:
    rm -rf _site
    bunx @11ty/eleventy

check: build
    {{wdk}} compat
    {{wdk}} smoke
    {{wdk}} a11y
